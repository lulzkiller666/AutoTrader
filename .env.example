# AutoTrader Configuration
# Copy this file to .env and fill in your API keys

# Required: OpenAI API Key
# Get yours at: https://platform.openai.com
OPENAI_API_KEY=sk-your-openai-key-here

# Required: Alpaca Paper Trading API
# Get yours at: https://alpaca.markets (free account)
ALPACA_API_KEY=your-alpaca-key
ALPACA_SECRET_KEY=your-alpaca-secret

# Optional: Model selection (defaults to gpt-4o)
# Options: gpt-4o, gpt-4o-mini, gpt-4-turbo
TRADING_MODEL=gpt-4o

# Optional: Professional Market Data APIs
# These provide better data quality and additional sources

# Polygon.io - Institutional-grade data (free tier: 5 req/min)
# https://polygon.io
POLYGON_API_KEY=

# Alpha Vantage - Market data and sentiment (free tier: 5 req/min)
# https://www.alphavantage.co
ALPHA_VANTAGE_KEY=

# Twelve Data - Market movers and quotes (free tier: 800 req/day)
# https://twelvedata.com
TWELVE_DATA_API_KEY=

# Finnhub - News sentiment analysis (free tier available)
# https://finnhub.io
FINNHUB_API_KEY=
